<?xml version="1.0" encoding="utf-8"?>
<!-- 墨墨 Token、模型 Key、EasyTier 密码都在 App 数据里：不进系统云备份，也不在换机时迁移 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
